{
  "name": "obsidian-notebook-reader",
  "version": "0.1.0",
  "description": "An iPad-first, mobile-compatible Obsidian plugin for browsing a vault like a physical notebook.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "build:preview": "node esbuild.config.mjs --preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "notebook",
    "reader",
    "ipad"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.14.0",
    "esbuild": "0.25.0",
    "jsdom": "26.1.0",
    "marked": "15.0.12",
    "tslib": "2.8.1",
    "typescript": "5.8.2",
    "vitest": "3.2.7"
  }
}
